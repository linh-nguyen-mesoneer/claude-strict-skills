#!/usr/bin/env bash
# Build a review package: commit list, stat summary, and the full diff with
# extended context, written to one file the reviewer reads in a single call.
#
# By default the package covers the whole change since the branch left the
# default branch: commits, staged and unstaged edits, and untracked files.
# Reviewing only BASE..HEAD silently drops uncommitted work, and HEAD~1 drops
# all but the last commit.
#
# Usage: review-package [--base REF] [--head REF] [--out FILE] [-- PATHSPEC...]
#   --base REF   compare against merge-base(REF, tip); default: the default
#                branch (origin/HEAD, origin/main, origin/master, main, master)
#   --head REF   review commits up to REF only; the working tree is excluded
#   --out FILE   write here; default: a fresh directory under $TMPDIR, outside
#                the repo. The reviewer reads the package after this script
#                exits, so the caller deletes that directory once the review
#                is over; nothing else removes it.
#   PATHSPEC     limit the package (relative to the repo root)
#
# A changed path whose diff attribute is unset (`package-lock.json -diff`, or
# the `binary` macro) would show only as "Binary files ... differ". Those paths
# are diffed with the in-tree .gitattributes ignored, so a real text change
# shows; content-based binary detection still applies. For them only, eol and
# filter conversions from .gitattributes are dropped too, so their diff shows
# raw working-tree bytes. Every other path keeps the normal attributes.
# `-diff` set in $GIT_DIR/info/attributes or core.attributesFile still hides
# the change. Needs git >= 2.40; older git warns and honors the attributes.
#
# Exit codes: 0 package written, 2 usage or git error, 3 nothing to review.
# Never touches the working tree, the index, or any ref.
set -euo pipefail

readonly CONTEXT_LINES=10
readonly EXIT_USAGE=2
readonly EXIT_EMPTY=3
# First git release that reads GIT_ATTR_SOURCE.
readonly ATTR_SOURCE_MIN_MAJOR=2
readonly ATTR_SOURCE_MIN_MINOR=40

die() {
  echo "review-package: $1" >&2
  exit "$EXIT_USAGE"
}

usage() {
  echo "usage: review-package [--base REF] [--head REF] [--out FILE] [-- PATHSPEC...]" >&2
  exit "$EXIT_USAGE"
}

base_ref=""
head_ref=""
out=""
pathspecs=()

while [ $# -gt 0 ]; do
  case $1 in
    --base | --head | --out)
      [ $# -ge 2 ] || usage
      case $1 in
        --base) base_ref=$2 ;;
        --head) head_ref=$2 ;;
        --out) out=$2 ;;
      esac
      shift 2
      ;;
    --)
      shift
      pathspecs=("$@")
      break
      ;;
    *) usage ;;
  esac
done

root=$(git rev-parse --show-toplevel 2>/dev/null) || die "not inside a git repository"
cd "$root"

git_reads_attr_source() {
  local version major minor
  version=$(git version) || return 1
  version=${version#git version }
  major=${version%%.*}
  minor=${version#*.}
  minor=${minor%%.*}
  case $major$minor in
    '' | *[!0-9]*) return 1 ;;
  esac
  [ "$major" -gt "$ATTR_SOURCE_MIN_MAJOR" ] ||
    { [ "$major" -eq "$ATTR_SOURCE_MIN_MAJOR" ] && [ "$minor" -ge "$ATTR_SOURCE_MIN_MINOR" ]; }
}

# Attribute source for paths marked -diff: the empty tree. Hashing it here
# yields the id for this repo's object format (SHA-1 or SHA-256). Empty when
# git cannot read GIT_ATTR_SOURCE; then no path is treated specially.
empty_tree=""
if git_reads_attr_source; then
  empty_tree=$(git hash-object -t tree /dev/null) || die "cannot hash the empty tree"
else
  echo "review-package: warning: git older than ${ATTR_SOURCE_MIN_MAJOR}.${ATTR_SOURCE_MIN_MINOR}; files marked -diff in .gitattributes show only as binary" >&2
fi

resolve_commit() {
  git rev-parse --verify --quiet "$1^{commit}" 2>/dev/null
}

default_base_ref() {
  local remote_head candidate
  remote_head=$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null || true)
  for candidate in $remote_head origin/main origin/master main master; do
    if resolve_commit "$candidate" >/dev/null; then
      echo "$candidate"
      return 0
    fi
  done
  return 1
}

tip_ref=${head_ref:-HEAD}
tip_sha=$(resolve_commit "$tip_ref") || die "bad --head: $tip_ref"

if [ -z "$base_ref" ]; then
  base_ref=$(default_base_ref) || die "no default branch found; pass --base REF"
fi
resolve_commit "$base_ref" >/dev/null || die "bad --base: $base_ref"
base_sha=$(git merge-base "$base_ref" "$tip_sha") || die "no common ancestor of $base_ref and $tip_ref"

# With --head the review is commits only; otherwise it ends at the working tree.
if [ -n "$head_ref" ]; then
  diff_range=("$base_sha" "$tip_sha")
  scope="commits only (working tree excluded)"
else
  diff_range=("$base_sha")
  scope="commits + staged + unstaged + untracked"
fi

# bash 3.2 (macOS) treats an empty array as unset under `set -u`.
diff_tracked() {
  git diff --no-ext-diff --no-color "$@" "${diff_range[@]}" -- ${pathspecs[@]+"${pathspecs[@]}"}
}

untracked=()
if [ -z "$head_ref" ]; then
  while IFS= read -r -d '' path; do
    untracked+=("$path")
  done < <(git ls-files --others --exclude-standard -z -- ${pathspecs[@]+"${pathspecs[@]}"})
fi

if diff_tracked --quiet && [ "${#untracked[@]}" -eq 0 ]; then
  echo "review-package: nothing to review against $(git rev-parse --short "$base_sha") ($base_ref); check the base" >&2
  exit "$EXIT_EMPTY"
fi

if [ -z "$out" ]; then
  tmp_root=${TMPDIR:-/tmp}
  out="$(mktemp -d "${tmp_root%/}/review-package.XXXXXX")/review.diff"
fi

# Changed paths, tracked or untracked, whose diff attribute is unset.
# Files, not a pipe into the loop, so a failing git command stops the script.
# Both sides of a rename are listed, so a rename whose two sides are both
# -diff stays one pair. If only one side is -diff, the pair is split into a
# delete and an add.
attr_unset=()
if [ -n "$empty_tree" ]; then
  attr_work=$(mktemp -d "${TMPDIR:-/tmp}/review-package-attrs.XXXXXX") || die "cannot create a temp directory"
  trap 'rm -rf "$attr_work"' EXIT
  git diff --no-ext-diff --no-renames --name-only -z "${diff_range[@]}" -- ${pathspecs[@]+"${pathspecs[@]}"} \
    >"$attr_work/paths" || die "git diff --name-only failed"
  if [ "${#untracked[@]}" -gt 0 ]; then
    printf '%s\0' "${untracked[@]}" >>"$attr_work/paths" || die "cannot write the path list"
  fi
  git check-attr -z --stdin diff <"$attr_work/paths" >"$attr_work/attrs" || die "git check-attr failed"
  # check-attr -z prints: path NUL attribute NUL value NUL, once per path.
  while IFS= read -r -d '' path && IFS= read -r -d '' _ && IFS= read -r -d '' value; do
    if [ "$value" = unset ]; then
      attr_unset+=("$path")
    fi
  done <"$attr_work/attrs"
fi

is_attr_unset() {
  local path
  for path in ${attr_unset[@]+"${attr_unset[@]}"}; do
    if [ "$path" = "$1" ]; then
      return 0
    fi
  done
  return 1
}

# Paths with the diff attribute unset go in a second diff that ignores the
# in-tree .gitattributes; all others keep the normal attributes.
diff_tracked_full() {
  local path excludes=() literals=()
  for path in ${attr_unset[@]+"${attr_unset[@]}"}; do
    excludes+=(":(exclude,literal)$path")
    literals+=(":(literal)$path")
  done
  git diff --no-ext-diff --no-color -U"$CONTEXT_LINES" "${diff_range[@]}" -- \
    ${pathspecs[@]+"${pathspecs[@]}"} ${excludes[@]+"${excludes[@]}"}
  if [ "${#literals[@]}" -gt 0 ]; then
    GIT_ATTR_SOURCE=$empty_tree git diff --no-ext-diff --no-color -U"$CONTEXT_LINES" \
      "${diff_range[@]}" -- "${literals[@]}"
  fi
}

diff_untracked() {
  local path status
  local diff_new=(git diff --no-ext-diff --no-color --no-index -U"$CONTEXT_LINES" --)
  for path in ${untracked[@]+"${untracked[@]}"}; do
    if [ ! -f "$path" ] || [ -L "$path" ]; then
      echo "(skipped, not a regular file: $path)"
      continue
    fi
    # --no-index exits 1 when the files differ, which is always the case here.
    status=0
    if is_attr_unset "$path"; then
      GIT_ATTR_SOURCE=$empty_tree "${diff_new[@]}" /dev/null "$path" || status=$?
    else
      "${diff_new[@]}" /dev/null "$path" || status=$?
    fi
    [ "$status" -le 1 ] || die "git diff failed for untracked file: $path"
  done
}

{
  echo "# Review package"
  echo "Base: $base_sha ($base_ref)"
  echo "Tip: $tip_sha ($tip_ref)"
  echo "Scope: $scope"
  [ "${#pathspecs[@]}" -eq 0 ] || echo "Pathspecs: ${pathspecs[*]}"
  echo
  echo "## Commits"
  git log --oneline "${base_sha}..${tip_sha}" -- ${pathspecs[@]+"${pathspecs[@]}"}
  echo
  echo "## Files changed"
  diff_tracked --stat
  if [ "${#untracked[@]}" -gt 0 ]; then
    echo
    echo "## Untracked files"
    printf '%s\n' "${untracked[@]}"
  fi
  echo
  echo "## Diff"
  diff_tracked_full
  diff_untracked
} >"$out"

commits=$(git rev-list --count "${base_sha}..${tip_sha}")
tracked=$(diff_tracked --name-only | wc -l | tr -d ' ')
bytes=$(wc -c <"$out" | tr -d ' ')
echo "wrote ${out}: base $(git rev-parse --short "$base_sha"), ${commits} commit(s), ${tracked} tracked file(s), ${#untracked[@]} untracked, ${bytes} bytes"
